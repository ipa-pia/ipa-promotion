# === Database Configuration ===
# Prisma 要求 schema.prisma 中 provider 必须写死（不支持 env()）。
# 本分支已固定为 postgresql，DATABASE_URL 使用 PostgreSQL 连接串。
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://user:pass@host:5432/db

# === Base Configuration ===
BASE_URL=http://localhost:3000

# === Auth Provider ===
# Options: clerk | better-auth | supabase | (empty = disabled)
# 模板在「构建期」按此变量注册 provider 专属的自动导入（如 useSupabaseClient），
# 首页直查 Supabase，故默认 supabase；留空会导致 pnpm build 报
# failed to find "useSupabaseClient" imported from "#imports"。
NUXT_PUBLIC_AUTH_PROVIDER=supabase
#
# ⚠️ MCP 硬前置条件：必须是 supabase
# 模板的 MCP 能力（/.well-known/oauth-protected-resource 发现元数据、/oauth/consent
# 同意页）只在 NUXT_PUBLIC_AUTH_PROVIDER=supabase 时注册；换成其他值后 MCP 端点会
# 静默消失（不报错，404）。该变量是构建期常量，改动后必须重新构建才生效。
# 模板默认按 `${NUXT_PUBLIC_SUPABASE_URL origin}/auth/v1` 推导发现元数据中的
# authorization_servers issuer，因此 SUPABASE_URL 也必须配置正确。

# === Clerk Configuration ===
# Used when NUXT_PUBLIC_AUTH_PROVIDER=clerk
# NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# NUXT_CLERK_SECRET_KEY=

# === Better-Auth Configuration ===
# Used when NUXT_PUBLIC_AUTH_PROVIDER=better-auth
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# === Supabase Configuration ===
# Used when NUXT_PUBLIC_AUTH_PROVIDER=supabase
# NUXT_PUBLIC_SUPABASE_URL=
# NUXT_PUBLIC_SUPABASE_ANON_KEY=
