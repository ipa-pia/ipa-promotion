# === Database Configuration ===
# Prisma 要求 schema.prisma 中 provider 必须写死（不支持 env()）。
# 本分支已固定为 postgresql，DATABASE_URL 使用 PostgreSQL 连接串。
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://user:pass@host:5432/db

# === Base Configuration ===
BASE_URL=http://localhost:3000

# === Auth Provider ===
# Options: clerk | better-auth | supabase | (empty = disabled)
# 模板在「构建期」按此变量注册 provider 专属的自动导入（如 useSupabaseClient），
# 首页直查 Supabase，故默认 supabase；留空会导致 pnpm build 报
# failed to find "useSupabaseClient" imported from "#imports"。
NUXT_PUBLIC_AUTH_PROVIDER=supabase

# === Clerk Configuration ===
# Used when NUXT_PUBLIC_AUTH_PROVIDER=clerk
# NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# NUXT_CLERK_SECRET_KEY=

# === Better-Auth Configuration ===
# Used when NUXT_PUBLIC_AUTH_PROVIDER=better-auth
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# === Supabase Configuration ===
# Used when NUXT_PUBLIC_AUTH_PROVIDER=supabase
# NUXT_PUBLIC_SUPABASE_URL=
# NUXT_PUBLIC_SUPABASE_ANON_KEY=

# === MCP（模板能力，LEOK-17）===
# ⚠️ 硬前置条件：MCP 发现元数据端点（/.well-known/oauth-protected-resource*）与
# OAuth 同意页（/oauth/consent）只在 NUXT_PUBLIC_AUTH_PROVIDER=supabase 时由模板注册。
# provider 换成 clerk / better-auth 或留空，即使 nuxt.config.ts 里 mcp.enabled: true
# 也不会有任何 MCP 端点（静默失效，不报错）。
# NUXT_PUBLIC_AUTH_PROVIDER 是构建期常量：改动后必须重新构建，不是运行时开关。
# NUXT_PUBLIC_SUPABASE_URL 同时决定发现元数据的 authorization_servers[0]
# （= <SUPABASE_URL origin>/auth/v1）；非 Supabase 授权服务器需改用
# nuxtTmpl.mcp.authorizationServer 显式覆盖，否则 RFC 8414 §3.3 Issuer mismatch。

# === MCP 真实端到端验收（仅本地验收使用；不要提交实际 token / Cookie）===
# MCP_TEST_ADMIN_ACCESS_TOKEN=
# MCP_TEST_USER_ACCESS_TOKEN=
# MCP_TEST_ADMIN_SESSION_COOKIE=
# MCP_TEST_DATABASE_URL=postgresql://readonly-user:password@host:5432/postgres